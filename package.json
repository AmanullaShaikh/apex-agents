{
  "name": "aveyx",
  "version": "3.0.3",
  "description": "Developer Tooling & Babel AST Context Compactor Harness: PageRank & Caller Graph Compactor, Git-Native Checkpoint & Rollback, Semantic Symbol Tracer, Static AST Bug Hunter, Token Volume & AST Compaction Auditor, Deterministic Test-Loop Runner, Codebase Dependency Graph, Anti-Test-Tampering Diff Auditor, Persistent Memory & Handoff, Git Worktree Sandboxes, and Native MCP Server for Claude Code, Cursor, Windsurf, Copilot, and Antigravity",
  "main": "bin/aveyx.js",
  "bin": {
    "aveyx": "bin/aveyx.js"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node ./scripts/validate-agents.js && node ./scripts/run-tests.js",
    "test:unit": "node ./scripts/run-tests.js",
    "test:agents": "node ./scripts/validate-agents.js",
    "test-loop": "node ./scripts/test-loop.js",
    "checkpoint": "node ./bin/aveyx.js checkpoint",
    "rollback": "node ./bin/aveyx.js rollback",
    "trace": "node ./bin/aveyx.js trace",
    "audit-bugs": "node ./bin/aveyx.js audit-bugs",
    "cost": "node ./bin/aveyx.js cost",
    "review": "node ./bin/aveyx.js review",
    "budget": "node ./bin/aveyx.js budget",
    "graph": "node ./bin/aveyx.js graph",
    "impact": "node ./bin/aveyx.js impact",
    "memory": "node ./bin/aveyx.js memory",
    "handoff": "node ./bin/aveyx.js handoff",
    "compact": "node ./bin/aveyx.js compact",
    "export-all": "node ./bin/aveyx.js export-all",
    "scan-secrets": "node ./scripts/scan-secrets.js",
    "sandbox": "node ./scripts/worktree-sandbox.js",
    "install-global": "node ./bin/aveyx.js install",
    "list": "node ./bin/aveyx.js list",
    "doctor": "node ./bin/aveyx.js doctor",
    "install-hooks": "node ./bin/aveyx.js install-hooks",
    "cursor-rules": "node ./bin/aveyx.js cursor-rules",
    "inject": "node ./bin/aveyx.js inject",
    "mcp": "node ./bin/mcp-server.js"
  },
  "keywords": [
    "agents",
    "claude-code",
    "cursor",
    "antigravity",
    "mcp",
    "mcp-server",
    "ast-compactor",
    "developer-tooling",
    "static-analysis",
    "security",
    "git-rollback"
  ],
  "author": "Amanulla Shaikh <businessamanulla@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmanullaShaikh/aveyx.git"
  },
  "bugs": {
    "url": "https://github.com/AmanullaShaikh/aveyx/issues"
  },
  "homepage": "https://github.com/AmanullaShaikh/aveyx#readme",
  "files": [
    "bin",
    "scripts",
    "agents",
    "instincts",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "dependencies": {
    "@babel/generator": "^8.1.2",
    "@babel/parser": "^8.1.2",
    "@babel/traverse": "^8.1.2"
  }
}

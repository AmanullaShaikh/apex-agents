{
  "name": "apex-agents",
  "version": "2.1.0",
  "description": "Developer Tooling & Babel AST Context Compactor Harness: PageRank & Caller Graph Compactor, Git-Native Checkpoint & Rollback, Semantic Symbol Tracer, Static AST Bug Hunter, Token Volume & AST Compaction Auditor, Deterministic Test-Loop Runner, Codebase Dependency Graph, Anti-Test-Tampering Diff Auditor, Session Handoff, Persistent Memory, Git Worktree Sandboxes, and Native MCP Server for Claude Code, Cursor, Windsurf, Copilot, and Antigravity",
  "main": "bin/apex.js",
  "bin": {
    "apex-agents": "bin/apex.js",
    "apex": "bin/apex.js"
  },
  "type": "module",
  "scripts": {
    "test": "node ./scripts/validate-agents.js && node ./scripts/run-tests.js",
    "test:unit": "node ./scripts/run-tests.js",
    "test:agents": "node ./scripts/validate-agents.js",
    "test-loop": "node ./scripts/test-loop.js",
    "checkpoint": "node ./bin/apex.js checkpoint",
    "rollback": "node ./bin/apex.js rollback",
    "trace": "node ./bin/apex.js trace",
    "audit-bugs": "node ./bin/apex.js audit-bugs",
    "cost": "node ./bin/apex.js cost",
    "review": "node ./bin/apex.js review",
    "budget": "node ./bin/apex.js budget",
    "graph": "node ./bin/apex.js graph",
    "diagram": "node ./bin/apex.js diagram",
    "memory": "node ./bin/apex.js memory",
    "handoff": "node ./bin/apex.js handoff",
    "compact": "node ./bin/apex.js compact",
    "export-all": "node ./bin/apex.js export-all",
    "studio": "node ./bin/apex.js studio",
    "scan-secrets": "node ./scripts/scan-secrets.js",
    "sandbox": "node ./scripts/worktree-sandbox.js",
    "install-global": "node ./bin/apex.js install",
    "list": "node ./bin/apex.js list",
    "doctor": "node ./bin/apex.js doctor",
    "mcp": "node ./bin/mcp-server.js"
  },
  "keywords": [
    "agents",
    "claude-code",
    "cursor",
    "antigravity",
    "mcp",
    "mcp-server",
    "ast-compactor",
    "developer-tooling",
    "static-analysis",
    "security",
    "git-rollback"
  ],
  "author": "Amanulla Shaikh <businessamanulla@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmanullaShaikh/apex-agents.git"
  },
  "bugs": {
    "url": "https://github.com/AmanullaShaikh/apex-agents/issues"
  },
  "homepage": "https://github.com/AmanullaShaikh/apex-agents#readme",
  "files": [
    "bin",
    "scripts",
    "agents",
    "instincts",
    "dashboard.html",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@babel/generator": "^8.1.2",
    "@babel/parser": "^8.1.2",
    "@babel/traverse": "^8.1.2"
  }
}
